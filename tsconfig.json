{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": [
      "jest"
    ],
    "typeRoots": [
      "./node_modules/@types"
    ],
    "jsx": "react-native",
    "paths": {
      "*": [
        "./src/*",
        "./tailwind/*"
      ],
      "assets/*": [
        "./src/assets/*"
      ],
      "features/*": [
        "./src/features/*"
      ],
      "services/*": [
        "./src/services/*"
      ],
      "shared/*": [
        "./src/shared/*"
      ],
      "tailwind/*": [
        "./tailwind/*"
      ],
      "tailwindConfig": [
        "./tailwind.config.js"
      ],
      "reusableTypes/*": [
        "./src/types/*"
      ],
      "menuAsset/*": [
        "./src/features/menu/assets/icons/*"
      ],
      "reusableHooks/*": [
        "./src/hooks/*"
      ],
      "navigation/*": [
        "./src/navigation/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.svg",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "**/node_modules",
    "**/Pods"
  ]
}