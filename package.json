{
  "name": "SteamShelf",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "test:watch": "jest --watch",
    "prettier": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,yml,yaml}\"",
    "lint:fix": "eslint . --fix",
    "format": "yarn prettier && yarn lint:fix",
    "lint:check": "eslint . --max-warnings 0",
    "prettier:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "yarn format"
    ]
  },
  "dependencies": {
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native/new-app-screen": "0.86.2",
    "@react-navigation/native": "^7.3.15",
    "@react-navigation/native-stack": "^7.18.7",
    "lodash": "^4.18.1",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-native": "npm:react-native-tvos@0.86.2-0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-reanimated": "^4.5.3",
    "react-native-safe-area-context": "^5.8.1",
    "react-native-screens": "^4.26.2",
    "react-native-svg": "^15.15.5",
    "react-native-worklets": "^0.11.3",
    "use-sync-external-store": "^1.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@cspell/eslint-plugin": "^10.0.1",
    "@eslint/js": "^9.39.1",
    "@jest/core": "29",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@react-native/metro-config": "0.86.2",
    "@react-native/typescript-config": "0.86.2",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "jest": "29",
    "jest-runtime": "29",
    "lint-staged": "^17.3.0",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "react-native-svg-transformer": "^1.5.3",
    "tailwindcss": "^3.4.17",
    "test-renderer": "1.2.0",
